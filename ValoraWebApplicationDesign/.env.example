# VALORA Frontend Production Environment Configuration
# Set your deployed Render backend URL:
VITE_API_URL=https://valora-backend.onrender.com

# In production, set to false to connect to the real Fastify + Supabase backend
VITE_USE_MOCKS=false

# Optional: override WebSocket URL (automatically derived from VITE_API_URL if omitted)
# VITE_WS_URL=wss://valora-backend.onrender.com/ws/chat
