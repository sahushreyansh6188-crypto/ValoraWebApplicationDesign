# VALORA Backend Environment Configuration

# ==========================================
# 1. Server & Networking (Required in Production)
# ==========================================
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
API_PREFIX=/api/v1

# CORS allowed origins (comma-separated or single domain).
# In production, set to your deployed frontend URL (e.g. https://valora.vercel.app).
CORS_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ==========================================
# 2. Database (Supabase PostgreSQL - Required)
# ==========================================
# DATABASE_URL: Transaction Pooler URL (port 6543 with ?pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct session connection (port 5432) for Prisma CLI/schema operations
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# 3. Security & Secrets (Required in Production)
# ==========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=valora_production_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=valora_production_jwt_refresh_secret_min_32_characters_long
COOKIE_SECRET=valora_production_cookie_secret_min_32_characters_long

# ==========================================
# 4. Stripe Billing (Test / Production)
# ==========================================
STRIPE_SECRET_KEY=sk_test_mock_secret_key
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret
STRIPE_CONNECT_PRICE_ID=price_mock_connect_14
STRIPE_ANNUAL_PRICE_ID=price_mock_annual_99

# ==========================================
# 5. Optional Integrations (Safe Defaults Exist)
# ==========================================
# Quota Enforcement (false by default for frictionless testing)
ENFORCE_QUOTAS=false

# Redis (Optional: if unset, backend cleanly falls back to built-in in-memory cache)
# REDIS_URL="redis://localhost:6379"

# Media Storage / CDN
MEDIA_CDN_URL=https://images.unsplash.com
# S3_ENDPOINT=https://mock.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=valora-media
# S3_ACCESS_KEY_ID=mock_access_key
# S3_SECRET_ACCESS_KEY=mock_secret_key

# Email Provider
EMAIL_FROM="VALORA <no-reply@valora.example.com>"
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=mock_user
# SMTP_PASS=mock_pass

# Google OAuth
# GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=mock_google_client_secret
