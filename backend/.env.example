# VALORA Backend Environment Configuration

# Server & Networking
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
# For Supabase:
# DATABASE_URL: Transaction Pooler URL (port 6543 with ?pgbouncer=true)
# DIRECT_URL: Direct session connection (port 5432) for Prisma migrations
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Redis (Optional in dev, falls back to in-memory)
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_ACCESS_SECRET=valora_development_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=valora_development_jwt_refresh_secret_min_32_characters_long
COOKIE_SECRET=valora_development_cookie_secret_min_32_characters_long

# Quota Enforcement (false by default for frictionless local testing)
ENFORCE_QUOTAS=false

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_mock_secret_key
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret
STRIPE_CONNECT_PRICE_ID=price_mock_connect_14
STRIPE_ANNUAL_PRICE_ID=price_mock_annual_99

# S3 / Cloudflare R2 Media Storage (Optional mock in dev)
S3_ENDPOINT=https://mock.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=valora-media-dev
S3_ACCESS_KEY_ID=mock_access_key
S3_SECRET_ACCESS_KEY=mock_secret_key
MEDIA_CDN_URL=https://images.unsplash.com

# Email Provider
EMAIL_FROM="VALORA <no-reply@valora.example.com>"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass

# Google OAuth
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
